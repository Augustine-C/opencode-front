      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.0",
      "@opentui/core": "0.7.0",
      "@opentui/keymap": "0.7.0",
      "@opentui/solid": "0.7.0",
      "@tanstack/solid-virtual": "3.13.37",
      "@standard-schema/spec": "1.1.0",
      "@kobalte/core": "0.13.13",
      "@corvu/drawer": "0.2.4",
      "@types/luxon": "3.7.1",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@astrojs/starlight": "0.41.11",
      "@cloudflare/workers-types": "4.20251008.0",
      "@pierre/diffs": "1.6.1",
      "@pierre/highlights": "0.2.0",
      "astro": "7.3.8",
      "@solid-primitives/event-listener": "2.4.6",
      "@solid-primitives/media": "2.3.6",
      "@solid-primitives/resize-observer": "2.2.0",
      "@solid-primitives/storage": "4.4.0",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.4",
      "dompurify": "3.4.17",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-169397b",
      "effect": "4.0.1",
      "fast-check": "4.9.0",
      "cross-spawn": "7.0.6",
      "hono": "4.13.13",
      "fuzzysort": "3.1.0",
      "get-east-asian-width": "1.6.0",
      "luxon": "3.6.1",
      "marked": "18.0.11",
      "marked-shiki": "1.2.1",
      "@playwright/test": "1.60.0",
      "semver": "7.7.4",
      "typescript": "npm:@typescript/typescript6@6.0.2",
      "@typescript/native": "npm:typescript@7.1.0-beta",
      "zod": "4.6.7",
      "remeda": "2.26.0",
      "sst": "4.13.1",
      "shiki": "4.4.3",
      "solid-list": "0.3.0",
      "string-width": "7.2.0",
      "tailwindcss": "4.1.11",
      "vite": "7.3.7",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "1.0.0",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "@sentry/solid": "10.71.0",
      "@sentry/vite-plugin": "5.4.0",
      "solid-js": "1.9.17",
      "solid-sonner": "0.3.1",
      "vite-plugin-solid": "2.11.10",
      "@lydell/node-pty": "1.2.0-beta.12"
    }
  },
  "scripts": {
    "dev": "bun run --cwd packages/app dev",
    "build": "bun run --cwd packages/app build && bun run scripts/desktop-build.ts",
    "typecheck": "bun run --cwd packages/app typecheck && bun run --cwd packages/codearts-proxy-extension typecheck && bun run typecheck:upstream && bun run --cwd packages/desktop typecheck",
    "test": "bun test --conditions=browser --preload ./packages/ui/test/solid-jsx.ts packages/app/test scripts/upstream/test packages/codearts-proxy-extension/test scripts/desktop/test scripts/build/test packages/desktop/src/main/plugin",
    "check": "bun run upstream:check && bun run typecheck && bun run test && bun run test:desktop-plugins",
    "desktop": "bun run scripts/desktop.ts",
    "upstream:check": "bun run scripts/upstream/check.ts check",
    "upstream:plan": "bun run scripts/upstream/check.ts plan",
    "typecheck:upstream": "tsc --ignoreConfig --noEmit --module ESNext --moduleResolution Bundler --target ESNext --types bun --skipLibCheck scripts/upstream/check.ts scripts/upstream/model.ts scripts/upstream/test/imports.test.ts",
    "upstream:record": "bun run scripts/upstream/check.ts record",
    "test:desktop-plugins": "bun run scripts/desktop-build.ts && bun --bun node_modules/vite/bin/vite.js build --config packages/app/performance/service-gui/vite.config.ts && node packages/desktop/test/native-host.mjs"
  },
  "devDependencies": {
    "@electron/packager": "19.0.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "electron": "44.9.1",
    "solid-js": "catalog:",
    "esbuild": "0.25.12"
  },
  "trustedDependencies": [
    "esbuild",
    "electron"
  ],
  "overrides": {
    "effect": "catalog:",
    "solid-js": "catalog:"
  },
  "patchedDependencies": {
    "@dnd-kit/dom@0.5.0": "patches/@dnd-kit%2Fdom@0.5.0.patch",
    "solid-js@1.9.17": "patches/solid-js@1.9.17.patch",
    "@tanstack/virtual-core@3.17.8": "patches/@tanstack%2Fvirtual-core@3.17.8.patch",
    "vite@8.2.4": "patches/vite@8.2.4.patch",
    "@corvu/drawer@0.2.4": "patches/@corvu%2Fdrawer@0.2.4.patch",
    "@pierre/trees@1.0.0-beta.6": "patches/@pierre%2Ftrees@1.0.0-beta.6.patch"
  }
}
