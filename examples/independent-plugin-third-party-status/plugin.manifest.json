{
  "formatVersion": 1,
  "id": "example.third-party-status",
  "name": "Third-party status",
  "version": "1.1.0",
  "apiVersion": 1,
  "runtimeVersion": "solid-v1",
  "entry": "main.js",
  "styles": [
    "styles/main.css"
  ],
  "capabilities": [
    "commands.register",
    "panels.register",
    "slots.register",
    "assets.read"
  ],
  "description": "An opt-in status footer and session panel that polls a user-supplied HTTP endpoint.",
  "license": "MIT",
  "configuration": {
    "fields": [
      {
        "key": "endpoint",
        "type": "string",
        "label": "Status endpoint",
        "description": "An HTTP endpoint returning label and value, with CORS enabled for the frontend.",
        "required": true
      },
      {
        "key": "interval",
        "type": "number",
        "label": "Poll interval (milliseconds)",
        "default": 60000,
        "min": 5000
      }
    ]
  }
}
