        "e2e/**",
        "component-tests/**",
        "src/storybook/**",
        "test-browser/**"
      ]
    },
    {
      "source": "packages/ui",
      "target": "packages/ui",
      "exclude": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.stories.*",
        "test/**",
        "tests/**",
        "e2e/**",
        "component-tests/**",
        "src/storybook/**",
        "test-browser/**"
      ],
      "keep": [
        "test/solid-jsx.ts"
      ]
    },
    {
      "source": "packages/session-ui",
      "target": "packages/session-ui",
      "exclude": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.stories.*",
        "test/**",
        "tests/**",
        "e2e/**",
        "component-tests/**",
        "src/storybook/**",
        "test-browser/**"
      ]
    },
    {
      "source": "packages/client",
      "target": "packages/client",
      "exclude": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.stories.*",
        "test/**",
        "tests/**",
        "e2e/**",
        "component-tests/**",
        "src/storybook/**",
        "test-browser/**"
      ],
      "keep": [
        "test/api.types.ts",
        "test/fixture/service-fixture.ts",
        "test/fixture/service-timing.ts",
        "test/fixture/service.ts"
      ]
    },
    {
      "source": "packages/schema",
      "target": "packages/schema",
      "exclude": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.stories.*",
        "test/**",
        "tests/**",
        "e2e/**",
        "component-tests/**",
        "src/storybook/**",
        "test-browser/**"
      ]
    },
    {
      "source": "packages/protocol",
      "target": "packages/protocol",
      "exclude": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.stories.*",
        "test/**",
        "tests/**",
        "e2e/**",
        "component-tests/**",
        "src/storybook/**",
        "test-browser/**"
      ]
    },
    {
      "source": "packages/util",
      "target": "packages/util",
      "exclude": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.stories.*",
        "test/**",
        "tests/**",
        "e2e/**",
        "component-tests/**",
        "src/storybook/**",
        "test-browser/**"
      ]
    },
    {
      "source": "packages/gui-plugins",
      "target": "packages/gui-plugins",
      "exclude": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.stories.*",
        "test/**",
        "tests/**",
        "e2e/**",
        "component-tests/**",
        "src/storybook/**",
        "test-browser/**"
      ]
    },
    {
      "source": "packages/plugin-browser",
      "target": "packages/plugin-browser",
      "only": [
        "package.json",
        "src/rpc.ts"
      ]
    },
    {
      "source": "patches",
      "target": "patches",
      "only": [
        "@dnd-kit%2Fdom@0.5.0.patch",
        "@pierre%2Ftrees@1.0.0-beta.6.patch",
        "@tanstack%2Fvirtual-core@3.17.8.patch",
        "solid-js@1.9.15.patch",
        "vite@8.2.2.patch",
        "@corvu%2Fdrawer@0.2.4.patch"
      ]
    },
    {
      "source": "LICENSE",
      "target": "LICENSE"
    },
    {
      "source": "packages/plugin",
      "target": "packages/plugin",
      "exclude": [
        "**/*.test.*",
        "**/*.spec.*",
        "test/**",
        "tests/**",
        "script/**"
      ],
      "only": [
        "package.json"
      ]
    },
    {
      "source": "packages/plugin/src/gui",
      "target": "packages/plugin/src/gui",
      "exclude": [
        "**/*.test.*",
        "**/*.spec.*"
      ]
    },
    {
      "source": "packages/patchmark",
      "target": "packages/patchmark",
      "exclude": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*.stories.*",
        "test/**",
        "tests/**",
        "e2e/**",
        "component-tests/**",
        "src/storybook/**",
        "test-browser/**"
      ]
    },
    {
      "source": "packages/plugin/src/rpc.ts",
      "target": "packages/plugin/src/rpc.ts"
    }
  ],
  "overlays": [
    {
      "id": "session-navigation",
      "reason": "Responsive search controls and message-history rail reuse native virtualized reveal operations; cancel stale search scrolling on query and session changes.",
      "files": [
        "packages/app/src/session/timeline/search-controller.ts",
        "packages/app/src/session/screen.tsx"
      ],
      "adapters": [
        "packages/app/src/extensions/session-navigation.ts",
        "packages/app/src/extensions/session-navigation-state.ts",
        "packages/app/src/extensions/session-navigation-view.tsx",
        "packages/app/src/extensions/session-navigation.css"
      ]
    },
    {
      "id": "port-localization",
      "reason": "Merge port-owned project tab and frontend plugin translations into the shared language dictionary while retaining pristine upstream locale files.",
      "files": [
        "packages/app/src/runtime/i18n/language.tsx",
        "packages/app/src/runtime/i18n/en.ts"
      ],
      "adapters": [
        "packages/app/src/extensions/project-tab-i18n.ts"
      ]
    },
    {
      "id": "generated-icons",
      "reason": "Generated frontend icons are retained independently of upstream icon generation inputs.",
      "files": [
        "packages/app/public/apple-touch-icon-v3.png",
        "packages/app/public/apple-touch-icon.png",
        "packages/app/public/favicon-96x96-v3.png",
        "packages/app/public/favicon-96x96.png",
        "packages/app/public/favicon-v3.ico",
        "packages/app/public/favicon-v3.svg",
        "packages/app/public/favicon.ico",
        "packages/app/public/favicon.svg",
        "packages/app/public/social-share-zen.png",
        "packages/app/public/social-share.png",
        "packages/app/public/web-app-manifest-192x192.png",
        "packages/app/public/web-app-manifest-512x512.png"
      ]
    },
    {
      "id": "project-tabs",
      "reason": "Optional instance/project grouping with drag ordering, quiet sidebar headings and compact horizontal conversation navigation.",
      "files": [
        "packages/app/src/settings/general/general.tsx",
        "packages/app/src/settings/model.tsx",
        "packages/app/src/shell/titlebar/tab-nav.tsx",
        "packages/app/src/shell/titlebar/tab-strip.tsx",
        "packages/app/src/shell/titlebar/titlebar.tsx",
        "packages/app/src/shell/layout/project-avatar-state.ts"
      ],
      "adapters": [
        "packages/app/src/extensions/project-tabs.tsx",
        "packages/app/src/extensions/project-tab-model.ts",
        "packages/app/src/extensions/tab-group-heading.tsx",
        "packages/app/src/extensions/tab-group-navigator.tsx",
        "packages/app/src/extensions/project-tabs.css",
        "packages/app/src/extensions/grouped-tab-status.tsx"
      ]
    },
    {
      "id": "service-attachment",
      "reason": "Connect to an existing service and discover its projects without managing a backend.",
      "files": [
        "packages/app/src/runtime/platform/web.ts",
        "packages/app/src/runtime/server/registry.tsx",
        "packages/app/src/runtime/server/runtime.tsx",
        "packages/app/src/servers/connect/screen.css",
        "packages/app/src/servers/connect/screen.tsx",
        "packages/app/src/runtime/server/health.ts"
      ],
      "adapters": []
    },
    {
      "id": "frontend-tooling",
      "reason": "Frontend-only build, package configuration, environment types, and contributor instructions.",
      "files": [
        "packages/app/AGENTS.md",
        "packages/app/package.json",
        "packages/app/src/custom-elements.d.ts",
        "packages/app/tsconfig.json",
        "packages/app/vite.config.ts",
        "packages/app/vite.icons.ts",
        "packages/client/package.json",
        "packages/plugin-browser/package.json",
        "packages/plugin/package.json"
      ]
    },
    {
      "id": "version-information",
      "reason": "Show independently versioned frontend builds, upstream GUI provenance and selected existing-service health without managing updates.",
      "files": [
        "packages/app/src/settings/about/about.tsx"
      ],
      "adapters": [
        "packages/app/src/extensions/build-info.ts",
        "packages/app/src/extensions/version-info.tsx",
        "packages/app/src/extensions/version-info.css"
      ]
    },
    {
      "id": "custom-gui-plugin",
      "reason": "Register the CodeArts Proxy plugin with the official GUI host.",
      "files": [
        "packages/app/src/runtime/plugin/builtins.ts"
      ],
      "adapters": [
        "packages/app/src/extensions/native.ts"
      ]
    }
  ],
  "local": [
    {
      "patterns": [
        ".gitignore",
        "AGENTS.md",
        "NOTICE",
        "README.md",
        "bun.lock",
        "package.json",
        "tsconfig.json",
        "docs/**",
        "examples/**",
        "scripts/**",
        "upstream/**",
        ".github/**"
      ],
      "reason": "Independent project metadata, tooling, documentation, and examples."
    },
    {
      "patterns": [
        "packages/frontend-plugin/**",
        "packages/app/src/plugins/**",
        "packages/app/src/extensions/**",
        "packages/app/test/**",
        "packages/app/performance/**",
        "packages/app/.env.example",
        "packages/app/icons/**",
        "packages/app/public/LICENSE",
        "packages/app/public/NOTICE"
      ],
      "reason": "Port-owned extension modules, regression tests, icon inputs, and redistributed notices."
    },
    {
      "patterns": [
        "packages/codearts-proxy-extension/**"
      ],
      "reason": "Portable native OpenCode v2 CodeArts Proxy GUI extension."
    }
  ]
}
